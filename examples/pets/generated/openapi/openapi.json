{
  "openapi": "3.2.0",
  "info": {
    "title": "Pet store",
    "version": "1.0.0",
    "description": "A small pet store: every kind of parameter, body and answer the emitter writes."
  },
  "tags": [
    {
      "name": "pets"
    },
    {
      "name": "admin"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "whoami",
        "summary": "Read the cookies.",
        "description": "The note is optional: a touch without one only marks the pet as seen.",
        "parameters": [
          {
            "name": "session",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": false
          },
          {
            "name": "theme",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/pets": {
      "get": {
        "operationId": "list_pets",
        "summary": "List pets.",
        "description": "Pets of one species, or tagged with all of `tag`, a page at a time.",
        "parameters": [
          {
            "name": "species",
            "in": "query",
            "required": false,
            "description": "Only this species.",
            "schema": {
              "$ref": "#/components/schemas/Species"
            },
            "explode": false
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Only pets with every one of these tags.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "description": "Only these ids, comma-separated (`ids=p1,p2`): an array that is not exploded.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PetId"
              }
            },
            "explode": false
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "The most pets to answer.",
            "schema": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1,
              "maximum": 100
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetPage"
                }
              }
            }
          }
        },
        "tags": [
          "pets"
        ]
      },
      "post": {
        "operationId": "create_pet",
        "summary": "Add a pet.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "headers": {
              "location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              "x-given-name": {
                "required": false,
                "description": "The name the pet was given, when it was changed on the way in.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "422": {
            "description": "Client error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPet"
              }
            }
          }
        }
      }
    },
    "/pets/{id}": {
      "get": {
        "operationId": "get_pet",
        "summary": "Read one pet.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PetId"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_pet",
        "summary": "Remove a pet.",
        "description": "Only an administrator may. The scope is for the server to enforce: the contract carries it, whatever it means.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PetId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "There is no content to send for this request, but the headers may be useful. "
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "tags": [
          "admin"
        ],
        "x-scope": "admin"
      }
    },
    "/pets/{id}/events": {
      "get": {
        "operationId": "pet_events",
        "summary": "Follow one pet.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PetId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "type": "string"
                    },
                    "data": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "event"
                  ],
                  "oneOf": [
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "$ref": "#/components/schemas/Pet"
                          }
                        },
                        "event": {
                          "const": "changed"
                        }
                      }
                    },
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "text/plain",
                          "contentSchema": {
                            "type": "string"
                          }
                        },
                        "event": {
                          "const": "gone"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{id}/touch": {
      "post": {
        "operationId": "touch_pet",
        "summary": "Touch a pet.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PetId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Note"
              }
            }
          }
        },
        "deprecated": true
      }
    }
  },
  "components": {
    "schemas": {
      "Census": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "format": "int32"
        },
        "description": "How many pets there are of each species, by the species' names."
      },
      "Companion": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Kitten"
          },
          {
            "$ref": "#/components/schemas/Puppy"
          }
        ],
        "description": "Either, which one the `kind` says."
      },
      "Dog": {
        "type": "object",
        "required": [
          "loud"
        ],
        "properties": {
          "loud": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/Pet"
          }
        ],
        "description": "A pet that barks: everything a `Pet` is, and how loudly."
      },
      "Failure": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable word to branch on."
          },
          "message": {
            "type": "string"
          }
        },
        "description": "Why a request was refused."
      },
      "Kitten": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "kitten"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "description": "A kitten, told from a puppy by its `kind`."
      },
      "Me": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          }
        },
        "description": "What the request's cookies say."
      },
      "NewPet": {
        "type": "object",
        "required": [
          "name",
          "species"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "species": {
            "$ref": "#/components/schemas/Species"
          },
          "age": {
            "type": "integer",
            "format": "uint8"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "price": {
            "type": "number",
            "format": "decimal"
          }
        },
        "description": "What it takes to add a pet."
      },
      "Note": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "description": "A note left with a pet."
      },
      "Pet": {
        "type": "object",
        "required": [
          "id",
          "name",
          "species",
          "tags"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PetId"
          },
          "name": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "uint8",
            "description": "Absent while nobody knows."
          },
          "species": {
            "$ref": "#/components/schemas/Species"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "price": {
            "type": "number",
            "format": "decimal",
            "description": "What it cost, as a decimal number."
          }
        },
        "description": "A pet in the store.",
        "examples": [
          {
            "id": "p1",
            "name": "Rex",
            "species": "dog",
            "tags": [
              "good"
            ]
          }
        ]
      },
      "PetEvent": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Pet"
          },
          {
            "type": "string"
          }
        ],
        "description": "What happens to a pet, as it happens."
      },
      "PetId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "The id of a pet, issued by the store."
      },
      "PetPage": {
        "type": "object",
        "required": [
          "pets"
        ],
        "properties": {
          "pets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pet"
            }
          },
          "next": {
            "type": "string",
            "description": "Where the next page begins, absent on the last."
          }
        },
        "description": "One page of pets."
      },
      "PetPatch": {
        "type": "object",
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "age": {
            "anyOf": [
              {
                "type": "integer",
                "format": "uint8"
              },
              {
                "type": "null"
              }
            ]
          },
          "mood": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "happy",
                  "sad"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "How it feels: one of two words, and may be cleared."
          }
        },
        "description": "What to change about a pet: a field left out stays, one that is `null` is cleared."
      },
      "Puppy": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "puppy"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "description": "A puppy, told from a kitten by its `kind`."
      },
      "Species": {
        "type": "string",
        "enum": [
          "dog",
          "cat",
          "bird"
        ],
        "description": "What a pet is."
      }
    }
  }
}
