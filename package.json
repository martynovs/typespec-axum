{
  "name": "@martynovs/typespec-rust-api",
  "version": "0.2.1",
  "description": "A TypeSpec emitter that writes the Rust of an API from its contract: serde wire types, an axum server, an HTTP client, an irpc protocol and the OpenAPI document.",
  "keywords": [
    "typespec",
    "emitter",
    "rust",
    "axum",
    "irpc",
    "client",
    "utoipa",
    "openapi"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martynovs/typespec-rust-api.git"
  },
  "homepage": "https://github.com/martynovs/typespec-rust-api#readme",
  "bugs": {
    "url": "https://github.com/martynovs/typespec-rust-api/issues"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "default": "./dist/src/index.js",
      "typespec": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/package.json",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "prepare": "tsc -p ."
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.17.0",
    "@typespec/events": ">=0.87.0 <1",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/streams": ">=0.87.0 <1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/events": "0.87.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@typespec/sse": "0.87.0",
    "@typespec/streams": "0.87.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
